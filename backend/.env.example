# AgentGate environment (copy to .env; .env is git-ignored)
# LLM provider is model-agnostic via LiteLLM. Set the model and its key.
AGENTGATE_LLM_MODEL=gemini/gemini-flash-lite-latest
GEMINI_API_KEY=your-key-here

# Alternate providers (optional): point AGENTGATE_LLM_MODEL at another provider
# (e.g. groq/llama-3.3-70b-versatile or openrouter/<model>) and set that
# provider's key — LiteLLM reads it from the environment. There is no automatic
# fallback chain; one configured model per process.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Duplicate store (optional for the advisory tools, REQUIRED for pay_invoice).
# Default is in-memory; set a file path to persist approvals and consumed
# decision tokens across restarts. /verify only READS this store. pay_invoice
# refuses to execute against an in-memory store: consumed tokens and
# reservations are the double-pay defense and must survive restarts.
# AGENTGATE_DB_PATH=agentgate.db

# Signing key for decision tokens (REQUIRED for the pay_invoice MCP tool; the
# advisory verify_action tool never needs it). Minimum 32 characters, no
# default ever — a default key would be unsigned execution in disguise.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AGENTGATE_SIGNING_KEY=

# System of record for fetch mode (optional). A directory of *.json invoice
# records; a request with source {"fetch": "INV-001"} resolves the record from
# here instead of accepting caller evidence — the agent chooses WHICH invoice,
# never what it says. Records are keyed by the invoice_number INSIDE each file
# (filenames are irrelevant) and validated like caller input. Unset = fetch
# requests fail closed to escalate.
# AGENTGATE_RECORDS_DIR=data/system_of_record

# Cross-origin access for the browser dashboard (optional). Comma-separated
# EXACT origins (scheme+host+port; localhost and 127.0.0.1 differ). Unset or
# empty = no cross-origin access at all — never "*".
# AGENTGATE_CORS_ORIGINS=http://127.0.0.1:3000

# Per-IP rate limit on POST /verify (optional). Default 120 requests/minute;
# 0 disables. Exposure hygiene for a publicly-attacked surface, not auth —
# above the ceiling the API answers HTTP 429 (transport-level, no Decision).
# AGENTGATE_RATE_LIMIT_PER_MINUTE=120

# Langfuse tracing (optional; requires `pip install -e ".[tracing]"`).
# Without both keys, tracing is a clean no-op and the service runs identically.
# A tracing failure never affects a decision.
# NOTE: keys are region-bound. Set LANGFUSE_HOST to the region in your
# Langfuse browser URL (cloud.langfuse.com = EU, us.cloud.langfuse.com,
# jp.cloud.langfuse.com); the SDK defaults to the EU host, and a region
# mismatch fails silently in the tracing layer (decisions are unaffected).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
